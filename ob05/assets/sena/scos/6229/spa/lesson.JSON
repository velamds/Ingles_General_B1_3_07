ents": [{"type": "pdf", "content": "engenn8le07ob05re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Describe someone you know."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le07ob05re2img05.jpg", "audiosrc": "engenn8le07ob05re2aud01", "images": [{"time": "0", "image": "engenn8le07ob05re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn8le07ob05re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>: This vintage shop is just the coolest place. The clothes aren't as cheap as I expected though!<br/><span class=\"strong\">Sally</span>: They're higher quality than at your typical second-hand shop. Look at these sweaters! They're not made as well today as they were twenty years ago.<br/><span class=\"strong\">Melodie</span>: Can I help you ladies?<br/><span class=\"strong\">Vanessa</span>: Melodie! You work here?<br/><span class=\"strong\">Melodie</span>: I'm here as often as I can be. Truth be told, I'm a bit of a workaholic.", "id": 1}, {"time": "24200", "image": "engenn8le07ob05re2img02.jpg", "text": "<span class=\"strong\">Vanessa</span>: I should say so, working here and at the restaurant! When do you go out? When do you socialize? <br/><span class=\"strong\">Melodie</span>:  It's only once a week. The pace is slower here. I get to meet people.<br/><span class=\"strong\">Vanessa</span>: Sally, this is Melodie. She's one of my best waiters. She's a gem - hardworking, attentive to customers and highly esteemed by her colleagues!<br/><span class=\"strong\">Sally</span>: Those are impressive attributes! I hear Vanessa can be quite demanding!<br/><span class=\"strong\">Melodie</span>: She's not as exacting as some I've worked for.<br/><span class=\"strong\">Vanessa</span>: Alright! I'm not as difficult as you may think Sally!", "id": 2}, {"time": "56500", "image": "engenn8le07ob05re2img01.jpg", "text": "<span class=\"strong\">Sally</span>: Hmm ... Let's return to a more interesting topic, like finery!\n<br/><span class=\"strong\">Melodie</span>: Our latest additions are here. Older garments that are not as seasonal as these are back here. <br/><span class=\"strong\">Vanessa</span>: Sally, you're in good hands. Melodie's a real go-getter!<br/><span class=\"strong\">Sally</span>: Ooo ... these are gorgeous! <br/><span class=\"strong\">Melodie</span>: You have better taste than most. These are some of our finest frocks! <br/><span class=\"strong\">Vanessa</span>: I'll just make myself comfortable. Sally is the consummate leisurely shopper.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "The Shopping Spree"}, {"type": "unit_name", "content": "Fancy Meeting You Here"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify and describe taste and style in fashion through a wider range of language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_2", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_3", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_4", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_5", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_6", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_7", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_8", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}]}, {"type": "background_image", "content": "engenn8le07ob05re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Making Comparisons"}, {"type": "describer", "content": "We use <span class=\"italic\">as</span> + adjective/adverb + <span class=\"italic\">as</span> to make comparisons when the things we are comparing are equal in some way:<br/><br/><span class=\"italic\">She is just <span class=\"strong\">as hardworking as</span> we are!</span><br/><br/>We use not <span class=\"italic\">as</span> ... <span class=\"italic\">as</span> to make comparisons between things which aren't equal:<br/><br/><span class=\"italic\">   The clothes are<span class=\"strong\">n't as cheap as</span> I expected though!</span>"}, {"type": "example", "content": "They're not made <span class=\"strong\">as well today as</span> they were twenty years ago."}, {"type": "example", "content": "I'm here <span class=\"strong\">as often as</span> I can be."}, {"type": "example", "content": "She's not <span class=\"strong\">as exacting as</span> some I've worked for."}, {"type": "example", "content": "Alright! I'm not <span class=\"strong\">as difficult as</span> you may think Sally! "}, {"type": "example", "content": "Older garments that are not <span class=\"strong\">as seasonal as</span> these are back here. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Superlatives/Comparatives"}, {"type": "describer", "content": "You use a comparative to compare somebody or something to <span class=\"strong\">one</span> other person or thing.<br/><br/>You use a superlative to compare somebody or something to the whole <span class=\"strong\">group</span> that he, she or it belongs to."}, {"type": "text", "content": "Look at the chart for information on how to form the comparative and superlative:"}, {"type": "table", "content": "{\"rows\":6,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Comparative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Superlative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cool\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cooler\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the coolest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Most adjectives:<br/><br/>+er, +-est\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"late\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"later\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the latest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjectives ending in -e:<br/><br/>+r, +-st\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"happier\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the happiest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2-syllable adje\u00ad\u00ad\u00adctives ending in -y:<br/><br/>+ier, +iest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"interesting\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"more interesting \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the most interesting\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3+-syllable adjectives:<br/><br/>more + adjective<br/><br/>most + adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"good<br/>bad\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"better (than)<br/>worse (than)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the best<br/>the worst\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Irregular comparisons\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "<ul><li>you use <span class=\"strong\">than</span> after comparatives</li><li>you add <span class=\"strong\">the</span> in front of the superlative form to describe people, places and things.</li></ul>"}, {"type": "example", "content": "The pace is slower here."}, {"type": "example", "content": "You have better taste than most."}, {"type": "example", "content": "These are some of our finest frocks!"}, {"type": "example", "content": "They're higher quality than at your typical second-hand shop. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "second-hand"}, {"type": "definition", "content": "already used or worn"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Vintage clothes are higher quality than the ones at a typical second-hand ones."}, {"type": "audio", "content": "engenn8le07ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you are talking about colleagues."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "truth be told"}, {"type": "definition", "content": "the truth is ..."}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Truth be told, I'm a bit of a workaholic.  "}, {"type": "audio", "content": "engenn8le07ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gem"}, {"type": "definition", "content": "something precious"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Melodie is a gem at the restaurant. I don't know what I'd do without her!"}, {"type": "audio", "content": "engenn8le07ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hardworking"}, {"type": "definition", "content": "works to the fullest"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She's a very hardworking individual."}, {"type": "audio", "content": "engenn8le07ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "attentive"}, {"type": "definition", "content": "listens carefully to and helps"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She's extremely attentive to her customers."}, {"type": "audio", "content": "engenn8le07ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "esteemed"}, {"type": "definition", "content": "well thought of "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She is highly esteemed by her peers. "}, {"type": "audio", "content": "engenn8le07ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "impressive"}, {"type": "definition", "content": "something you respect or admire"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It's an impressive display of food!"}, {"type": "audio", "content": "engenn8le07ob05aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "attribute"}, {"type": "definition", "content": "characteristic"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Melodie has impressive attributes. "}, {"type": "audio", "content": "engenn8le07ob05aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "exacting"}, {"type": "definition", "content": "demanding"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Vanessa is not as exacting as some bosses."}, {"type": "audio", "content": "engenn8le07ob05aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a friend or classmate that you know well."}, {"type": "text", "content": "Describe the friend's personality and behaviour."}, {"type": "text", "content": "Compare your personalities."}, {"type": "text", "content": "Write a 100-word descriptive paragraph about your friend."}, {"type": "text", "content": "Read the paragraph aloud."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I describe the personality and behaviour of someone I know."}, {"type": "text", "content": "I make comparisons between my personality and the person I know."}, {"type": "text", "content": "I write a description of the person."}, {"type": "text", "content": "I share my description aloud."}]}]}