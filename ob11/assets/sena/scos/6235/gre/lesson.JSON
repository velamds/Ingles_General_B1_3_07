"scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le07ob11re2img05.jpg", "audiosrc": "engenn8le07ob11re2aud01", "images": [{"time": "0", "image": "engenn8le07ob11re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le07ob11re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter</span>: I think this was a great idea!<br/>\n<span class=\"strong\">Vanessa</span>: So do we!<br/>\n<span class=\"strong\">Peter</span>: The old slick Hollywood musicals! I'm glad I could make it! <br/>\n<span class=\"strong\">Vanessa</span>: So are we! <br/>\n<span class=\"strong\">Peter</span>: This is as exciting as it gets for a movie buff like me! The food is as good as I get from the priciest places in town!<br/>\n<span class=\"strong\">Sally</span>: I think so too. I can't remember having better snacks than these!<br/>\n<span class=\"strong\">Peter</span>: These are the most delicious sandwiches. Mine are never as tasty as yours.<br/>\n<span class=\"strong\">Sally</span>: Neither are mine!<br/>\n<span class=\"strong\">Peter</span>: Even though we are cooking as often as we can these days. Right Sal!"}, {"time": "30000", "image": "engenn8le07ob11re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: You'll be as good a cook as most people in no time.<br/>\n<span class=\"strong\">Sally</span>: I'm not so sure about that ...<br/>\n<span class=\"strong\">Peter</span>: Neither am I. My food is edible, but that is as far as it goes for now, I think.<br/>\n<span class=\"strong\">Sally</span>: Me too. I'm never going to be a great cook!<br/>\n<span class=\"strong\">Peter</span>: I'm not either, Sal. <br/>\n<span class=\"strong\">Vanessa</span>: Show Peter the latest pictures of your purchases from our shopathon!"}, {"time": "49500", "image": "engenn8le07ob11re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: Have a look. I am stepping up my game! I'm mixing vintage and new. Aren't they the coolest?! I got some neat marked down accessories!<br/>\n<span class=\"strong\">Peter</span>: The businesswomen in Boston don't look as fashionable as this, Sal. It's so much trendier! Hey, how was the music festival?<br/>\n<span class=\"strong\">Vanessa</span>: Classical, rap ... it was a bit disappointing.<br/>\n<span class=\"strong\">Peter</span>:  Ah, but tonight will make up for it!<br/>\n<span class=\"strong\">Sally</span>: Oh Peter!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "The Shopping Spree"}, {"type": "unit_name", "content": "Looking Cool!"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "B1.3"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and describe taste and style in music and fashion through a wider range of language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_2", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_3", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_4", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_5", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_6", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_7", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_8", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level."}], "type": "objectives"}, {"type": "background_image", "content": "engenn8le07ob11re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Making Comparisons"}, {"type": "describer", "content": "We use <span class=\"italic\">as</span> + adjective/adverb + <span class=\"italic\">as</span> to make comparisons when the things we are comparing are equal in some way:<br/><br/><span class=\"italic\">This leather jacket is <span class=\"strong\">as soft as</span> a sweater!</span><br/><br/>We use not <span class=\"italic\">as</span> ... <span class=\"italic\">as</span> to make comparisons between things which aren't equal:<br/><br/><span class=\"italic\">This leather jacket is<span class=\"strong\">n't as expensive as</span> that one.</span>"}, {"type": "example", "content": "I'm not <span class=\"strong\">as well versed on names of musicals as</span> I should be though."}, {"type": "example", "content": "That would give us a list of <span class=\"strong\">as many movies as</span> we could watch in an evening."}, {"type": "example", "content": "It wasn't nearly <span class=\"strong\">as good as</span> others we've been to."}, {"type": "example", "content": "Maybe this wasn't <span class=\"strong\">as interesting as</span> others because we're a bit jaded."}, {"type": "example", "content": "When you have been to <span class=\"strong\">as many good concerts as</span> we've been to, we shouldn't complain."}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Responses with <span class=\"italic\">So</span> and <span class=\"italic\">Neither</span>"}, {"type": "describer", "content": "We us <span class=\"italic\">so</span> and <span class=\"italic\">neither</span> for positive and negative agreement."}, {"type": "text", "content": "<span class=\"italic\">So</span> is used to show agreement with positive statements. <br/>Sometimes we also use <span class=\"italic\">too</span> to express the same thing."}, {"type": "text", "content": "Example:<br/><br/><span class=\"strong\">Amanda</span>: <span class=\"italic\">I like this dress!</span></span><br/><span class=\"strong\">Janet</span>: <span class=\"italic\">So do I. / I do too.</span>"}, {"type": "text", "content": "<span class=\"italic\">Neither</span> is used to show agreement with negative statements. <br/>Sometimes we also use <span class=\"italic\">either</span> to express the same thing."}, {"type": "text", "content": "Example:<br/><br/><span class=\"strong\">Amanda</span>:<br/><span class=\"italic\"> I don't think this fits well.</span><br/><span class=\"strong\">Janet</span>:<br/><span class=\"italic\">Neither do I. </span>(neither is a negative word)<br/><span class=\"italic\">I don't either. </span>(either is used with the negative)"}, {"type": "text", "content": "When you use <span class=\"italic\">so</span> and <span class=\"italic\">neither</span>, the auxiliary needs to agree with the verb tense in the original statement."}, {"type": "text", "content": "A more colloquial form of positive agreement is <span class=\"italic\">Me too</span>.<br/>A more colloquial form of negative agreement is <span class=\"italic\">Me neither</span>."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Statement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Positive agreement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><p>I think this was a great idea!</p><p>I'm glad I could make it!</p><p>The food is as good as I get from the priciest places in town!</p><p>That is as far as it goes for now, I think.</p></span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><p>So do we!</p><p>So are we! </p><p>I think so too.</p><p>Me too.</p></span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Statement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Negative agreement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><p>Mine are never as tasty as yours.</p><p>I'm not so sure about that ...</p><p>I'm never going to be a great cook!</p></span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><p>Neither are mine!</p><p>Neither am I. </p><p>I'm not either, Sal.</p></span>\\\"}\"],\"styles\":\" intro_table_border\"}"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "movie buff"}, {"type": "definition", "content": "someone who knows a lot about movies"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He's a big movie buff; he watched movies all weekend."}, {"type": "audio", "content": "engenn8le07ob11aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you need to review."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "Hollywood"}, {"type": "definition", "content": "a place in the U.S. that is famous for making films"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'd like to watch some old Hollywood musicals this weekend. "}, {"type": "audio", "content": "engenn8le07ob11aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "slick"}, {"type": "definition", "content": "well done; expertly done "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The Music Man parody was almost as slick as past musical productions."}, {"type": "audio", "content": "engenn8le07ob11aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "shopathon"}, {"type": "definition", "content": "a marathon shopping trip"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I don't think Peter is up to one of our shopathons."}, {"type": "audio", "content": "engenn8le07ob11aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "vintage-look"}, {"type": "definition", "content": "looks like it made in the past"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It's a vintage-look top. "}, {"type": "audio", "content": "engenn8le07ob11aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "rap "}, {"type": "definition", "content": "a type of music"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm not fond of rap but I like rock 'n' roll."}, {"type": "audio", "content": "engenn8le07ob11aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "marked down"}, {"type": "definition", "content": "on sale"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: The clothing is marked down."}, {"type": "audio", "content": "engenn8le07ob11aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to step up your game"}, {"type": "definition", "content": "to compete at a higher level"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I have to step up my game at work."}, {"type": "audio", "content": "engenn8le07ob11aud08"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Identify what type of movies you like."}, {"type": "text", "content": "Say what types are the best or the worst for you."}, {"type": "text", "content": "Write a review of 125 words on a movie you have recently seen and liked."}, {"type": "text", "content": "Write a comparison of it to another movie in your review."}, {"type": "text", "content": "Read your review aloud and discuss it with someone."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about movies."}, {"type": "text", "content": "I write a review about a movie."}, {"type": "text", "content": "I compare two movies in my review."}, {"type": "text", "content": "I share my review."}]}]}