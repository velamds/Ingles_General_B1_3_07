erride": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le07ob09re2img05.jpg", "audiosrc": "engenn8le07ob09re2aud01", "images": [{"time": "0", "image": "engenn8le07ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le07ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: My feet are still killing me from walking in those shoes!<br/>\n<span class=\"strong\">Vanessa</span>: It serves you right. We went to a festival, not to a night club. <br/><span class=\"strong\">Sally</span>: I didn't think it was going to go on as long as it did.<br/>\n<span class=\"strong\">Vanessa</span>: I was certainly happy it wasn't as deafening as the one last year. <br/><span class=\"strong\">Sally</span>: So was I. My ears rang for days after that one!"}, {"time": "18000", "image": "engenn8le07ob09re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: I didn't enjoy the first few sets. I'm not fond of rap.<br/>\n<span class=\"strong\">Sally</span>: Neither am I. I'm more of a rock and roll girl.<br/>\n<span class=\"strong\">Vanessa</span>: I am too sometimes. I didn't like the neo-classical numbers either.<br/>\n<span class=\"strong\">Sally</span>: Neither did I. I was surprised the bands weren't as interesting as the bands that played last year.<br/>\n<span class=\"strong\">Vanessa</span>: So was I. In fact, I was a little disappointed.<br/>\n<span class=\"strong\">Sally</span>: Me too. I'm not sure I'll go back again next year."}, {"time": "40000", "image": "engenn8le07ob09re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Me neither. I can't remember when I was as disappointed in a festival as I was this time.<br/>\n<span class=\"strong\">Sally</span>: Neither can I. The arts area was just as well laid out as it was last time. The Music Man parody was almost as slick as past musical productions.<br/>\n<span class=\"strong\">Vanessa</span>: The cafe tent with buskers were fun. I loved talking to some of the other festival goers over coffee. <br/><span class=\"strong\">Sally</span>: I liked browsing the craft tents too.<br/>\n<span class=\"strong\">Vanessa</span>: Let's go back to mine and relax. Maybe watch a movie ...<br/>\n<span class=\"strong\">Sally</span>: Sounds heavenly!"}]}}], "id": 1}], "id": 0}], "_data": [{"contents": [{"content": "The Shopping Spree", "type": "lesson_name"}, {"content": "The Music Man", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "B1.3", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Identify and describe taste and style in music through a wider range of language in both work and social contexts.", "type": "primary"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": " Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Making Comparisons", "type": "heading"}, {"content": "We use <span class=\"italic\">as</span> + adjective/adverb +  <span class=\"italic\">as</span> to make comparisons when the things we are comparing are equal in some way: <br/> <span class=\"italic\">This leather jacket is <span class=\"strong\">as  soft as</span> a sweater!</span> <br/><br/>  We use  <span class=\"italic\">not as ... as</span> to make comparisons between things which aren't equal:<br/>  <span class=\"italic\">This leather jacket isn't <span class=\"strong\">as expensive as</span> that one.</span>", "type": "describer"}, {"content": "I didn't think it was going to go on <span class=\"strong\">as long as</span> it did.", "type": "example"}, {"content": "It wasn't <span class=\"strong\">as deafening as</span> the one last year. ", "type": "example"}, {"content": "The bands <span class=\"strong\">weren't as interesting as</span> the bands that played last year.", "type": "example"}, {"content": "I can't remember when I was <span class=\"strong\">as disappointed in a festival as</span> I was this time.", "type": "example"}, {"content": "The arts area was <span class=\"strong\">just as well laid out as</span> it was last time. ", "type": "example"}, {"content": " The Music Man parody was <span class=\"strong\">almost as slick as</span> past musical productions.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Responses with <span class=\"italic\">So</span> and <span class=\"italic\">Neither</span>", "type": "heading"}, {"content": "We us <span class=\"italic\">so</span> and <span class=\"italic\">neither</span> for positive and negative agreement.", "type": "describer"}, {"content": "<span class=\"italic\">So</span> is used to show agreement with positive statements. <br/>Sometimes we also use <span class=\"italic\">too</span> to express the same thing.", "type": "text"}, {"content": "Example:<br/><br/><span class=\"strong\">Amanda</span>: <span class=\"italic\">I like this dress!</span></span><br/><span class=\"strong\">Janet</span>: <span class=\"italic\">So do I. / I do too.</span>", "type": "text"}, {"content": "<span class=\"italic\">Neither</span> is used to show agreement with negative statements. <br/>Sometimes we also use <span class=\"italic\">either</span> to express the same thing.", "type": "text"}, {"content": "Example:<br/><br/><span class=\"strong\">Amanda</span>:<br/><span class=\"italic\"> I don't think this fits well.</span><br/><span class=\"strong\">Janet</span>:<br/><span class=\"italic\">Neither do I. </span>(neither is a negative word)<br/><span class=\"italic\">I don't either. </span>(either is used with the negative)", "type": "text"}, {"content": "When you use <span class=\"italic\">so</span> and <span class=\"italic\">neither</span>, the auxiliary needs to agree with the verb tense in the original statement.", "type": "text"}, {"content": "A more colloquial form of positive agreement is <span class=\"italic\">Me too</span>.", "type": "text"}, {"content": "A more colloquial form of negative agreement is <span class=\"italic\">Me neither</span>.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Statement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Positive agreement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I was certainly happy it wasn't as deafening as the one last year. <br/><br/>  I'm more of a rock and roll girl.<br/><br/>  I was surprised the bands weren't as interesting as the bands that played last year. <br/><br/> In fact, I was a little disappointed.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">So was I. <br/><br/>    I am too sometimes.<br/><br/>   So was I. <br/><br/>    Me too. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Statement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Negative agreement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I didn't like the neo-classical numbers either.<br/><br/>  I'm not fond of rap.<br/><br/>  I'm not sure I'll go back again next year.<br/><br/>   I can't remember when I was as disappointed in a festival as I was this time.<br/><br/> </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">Neither did I. <br/><br/>   Neither am I. <br/><br/>   Me neither. <br/><br/>    Neither can I. </span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": " These are words you use to talk about a music festival.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "My feet are killing me! ", "type": "name"}, {"content": "my feet are very sore", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My feet are still killing me from walking in those shoes!", "type": "example"}, {"content": "engenn8le07ob09aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "deafening", "type": "name"}, {"content": "extremely loud ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example:  The music festival wasn't as deafening as the one last year. ", "type": "example"}, {"content": "engenn8le07ob09aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "rap", "type": "name"}, {"content": "a type of music", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example I'm not fond of rap but I like rock 'n' roll.", "type": "example"}, {"content": "engenn8le07ob09aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to ring", "type": "name"}, {"content": " a sound in the ears from listening to loud music", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: My ears rang for days after that concert! ", "type": "example"}, {"content": "engenn8le07ob09aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "number", "type": "name"}, {"content": "a part of a musical show", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I didn't like the neo-classical numbers.", "type": "example"}, {"content": "engenn8le07ob09aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "slick", "type": "name"}, {"content": "well done; expertly done ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The <span class=\"italic\">Music Man</s[pan parody was almost as slick as past musical productions.", "type": "example"}, {"content": "engenn8le07ob09aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "busker", "type": "name"}, {"content": " a street singer who asks for donations ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Music Man parody was almost as slick as past musical productions.", "type": "example"}, {"content": "engenn8le07ob09aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "parody", "type": "name"}, {"content": "satire", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Music Man parody was really funny!", "type": "example"}, {"content": "engenn8le07ob09aud08", "type": "audio"}], "type": "target_word"}, {"content": "engenn8le07ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Identify three types of music you enjoy.", "type": "text"}, {"content": "Write a paragraph comparing the types music.", "type": "text"}, {"content": "Find someone who likes the same music as you.", "type": "text"}, {"content": "Write sentences and responses using agreement (So do I, etc.).", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I identify three types of music.", "type": "text"}, {"content": "I write a paragraph comparing the three types of music.", "type": "text"}, {"content": "I find someone who likes the same music as I do.", "type": "text"}, {"content": "I write statements and response using agreement.", "type": "text"}]}], "type": "sena"}